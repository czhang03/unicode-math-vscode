{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"rootDir": "src",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"types": [
			"node",
			"vscode"
		],
		"strict": true
